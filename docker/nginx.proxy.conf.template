server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/mime.types;
    types {
        application/javascript js mjs;
    }

    # Used when PROXY=ON (see docker/entrypoint.sh).
    # Reverse proxy: all API traffic to the private backend VM.
    # BACKEND_INTERNAL_URL is the backend's host:port ONLY (e.g. http://10.20.51.42:3000),
    # substituted at container start (see entrypoint.sh). proxy_pass intentionally has
    # no URI/trailing slash, so the full original request path — including the backend's
    # own /api/v1 prefix carried by VITE_API_BASE_URL — is forwarded verbatim, with no
    # prefix stripping and no URI re-encoding.
    location /api/ {
        proxy_pass ${BACKEND_INTERNAL_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        client_max_body_size 25M;
    }

    # SPA routing fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss;
}
