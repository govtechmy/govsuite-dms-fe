# Short-lived cache of storage auth_request results (see /_storage_auth below).
# This file is included inside nginx's http {} block, so http-level directives are valid here.
proxy_cache_path /var/cache/nginx/storage_auth keys_zone=storage_auth:1m max_size=10m inactive=1m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/mime.types;
    types {
        application/javascript js mjs;
    }

    # Used when PROXY=ON (see docker/entrypoint.sh).
    # Reverse proxy: all API traffic to the private backend VM.
    # BACKEND_INTERNAL_URL is the backend's host:port ONLY (e.g. http://10.20.51.42:3000),
    # substituted at container start (see entrypoint.sh). proxy_pass intentionally has
    # no URI/trailing slash, so the full original request path — including the backend's
    # own /api/v1 prefix carried by VITE_API_BASE_URL — is forwarded verbatim, with no
    # prefix stripping and no URI re-encoding.
    location /api/ {
        proxy_pass ${BACKEND_INTERNAL_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        client_max_body_size 25M;
    }

    # Garage S3 reverse proxy. With backend PROXY=true, presigned URLs are returned
    # path-only (/<bucket>/<key>?X-Amz-...) so the browser sends them here. The URI is
    # forwarded verbatim (no URI on proxy_pass) and Host is left as nginx's default
    # ($proxy_host = STORAGE_INTERNAL_URL's host:port), which must equal the backend's
    # S3_ENDPOINT because that is the host the signature was computed for.
    location /${S3_BUCKET_NAME}/ {
        limit_except GET HEAD PUT { deny all; }
        # Every request must carry the user's own Bearer token; the backend re-checks the
        # session and record access each time, so a copied link on its own gets 401/403.
        auth_request /_storage_auth;
        proxy_pass ${STORAGE_INTERNAL_URL};
        # The Bearer token is for the backend only. Garage would try to parse it as S3 auth
        # and reject the request, so it must not be forwarded.
        proxy_set_header Authorization "";
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        gzip off;
        client_max_body_size ${STORAGE_MAX_BODY_SIZE};
        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # auth_request target for /${S3_BUCKET_NAME}/. Backend answers 204 (allow), 401 (no/expired
    # session) or 403 (no access to that object). pdf.js makes many Range requests per PDF,
    # so an "allow" is cached for 30s per token + method + object; denials are never cached.
    location = /_storage_auth {
        internal;
        proxy_pass ${BACKEND_INTERNAL_URL}/api/v1/record/storage-auth;
        proxy_http_version 1.1;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache storage_auth;
        proxy_cache_key "$http_authorization|$request_method|$uri";
        proxy_cache_valid 204 30s;
        proxy_cache_valid any 0;
        proxy_ignore_headers Cache-Control Expires;
    }

    # SPA routing fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss;
}
