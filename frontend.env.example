# Environment Variables - Source of Truth
# 
# This file is the single source of truth for all environment variables.
# All VITE_* variables defined here will be automatically injected at runtime in Docker.
#
# For local development:
#   1. Copy this file: cp frontend.env.example frontend.env
#   2. Update frontend.env with your actual values (do not commit frontend.env)
#   3. Make sure that on adding env for development, add here too.
#
# For Docker deployment:
#   Pass these as environment variables: docker run -e VITE_API_BASE_URL=... etc.
#
# When adding new variables:
#   1. Add them here with VITE_ prefix
#   2. No code update needed; keys are auto-detected from this file
#
# WARNING: Never prefix the backend's private address with VITE_ — VITE_*
# variables are written into env.js and shipped to every browser.

VITE_APP_NAME=GovSuite DMS
VITE_EMAIL_SUPPORT=support@support.gov.my

# PROXY (NOT VITE_ prefixed) toggles whether the frontend reverse-proxies
# /api to the backend, or the browser calls the backend directly.
#
# PROXY=ON (case-insensitive):
#   - VITE_API_BASE_URL must be a same-origin relative path INCLUDING the
#     backend's own API prefix, e.g. /api/v1, with NO trailing slash.
#   - BACKEND_INTERNAL_URL is REQUIRED — the backend's private host:port only
#     (no /api/v1 suffix, no trailing slash). The container refuses to start
#     without it. The backend address is never exposed to the browser.
#   - DEV_API_PROXY_TARGET is used by the Vite dev-server /api proxy locally
#     (host:port only, same rules as BACKEND_INTERNAL_URL).
#
# PROXY unset/anything else (OFF):
#   - VITE_API_BASE_URL must be the backend's FULL public URL, e.g.
#     http://10.20.51.42:3000/api/v1 — the browser calls it directly.
#   - BACKEND_INTERNAL_URL / DEV_API_PROXY_TARGET are not used.
PROXY=ON

VITE_API_BASE_URL=/api/v1

# Dev only (NOT VITE_ prefixed), used only when PROXY=ON.
DEV_API_PROXY_TARGET=http://localhost:3000

# Docker/production only (NOT VITE_ prefixed), REQUIRED when PROXY=ON.
# BACKEND_INTERNAL_URL=http://10.20.51.42:3000